<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jtacsim.plugin">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!--
            ATAK looks for this meta-data tag at plugin load time. The value
            is the resource name of the plugin manifest XML.
            See res/xml/atak_plugin.xml.
        -->
        <meta-data
            android:name="atak.plugin"
            android:resource="@xml/atak_plugin" />

    </application>
</manifest>
