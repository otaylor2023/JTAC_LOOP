# Copy to deploy/.env and edit. Required for docker compose.

# IPv4 address phones/tablets on your Wi‑Fi use to reach this computer.
# Find it: macOS System Settings → Network, or `ipconfig getifaddr en0`
FTS_IP=10.1.61.69

# Match docker-compose.yml defaults unless you changed them.
FTS_FED_PASSWORD=defaultpass
FTS_CLIENT_CERT_PASSWORD=supersecret
FTS_WEBSOCKET_KEY=YourWebsocketKey
FTS_SECRET_KEY=change_this_secret_in_production
FTS_CONNECTION_MESSAGE=Welcome to FreeTAKServer
